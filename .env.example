# Plane Configuration
PLANE_API_KEY=plane_api_xxxxx
PLANE_WORKSPACE_SLUG=my-workspace
PLANE_PROJECT_ID=00000000-0000-0000-0000-000000000000
PLANE_BASE_URL=https://api.plane.so

# GitHub App Configuration
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Optional: GitHub App Private Key as base64-encoded string
# Use this instead of GITHUB_APP_PRIVATE_KEY_PATH for containerized deployments
# GITHUB_APP_PRIVATE_KEY_BASE64=base64-encoded-private-key

# Status Mapping Configuration
STATUS_MAPPING_FILE=config/status-mapping.yml

# Bot Configuration
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# Optional: Webhook URL (for logging/debugging purposes)
WEBHOOK_BASE_URL=https://my-bot.example.com
